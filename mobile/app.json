{
  "expo": {
    "name": "Kimkloset",
    "slug": "kimkloset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kimkloset",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kimprudy.kimkloset",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kimprudy.kimkloset",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74584ad1-c589-41aa-8766-00d71a741730"
      }
    },
    "owner": "kimprudy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74584ad1-c589-41aa-8766-00d71a741730"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
