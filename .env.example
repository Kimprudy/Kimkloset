# Copy this file to .env.local and fill in your own keys. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Paystack → Settings → API Keys & Webhooks (Test Secret Key)
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key

# Mailgun → API Keys / Sending → Domains
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-sandbox-domain.mailgun.org
MAILGUN_FROM="Kimkloset <postmaster@your-sandbox-domain.mailgun.org>"
MAILGUN_API_BASE=https://api.mailgun.net

# http://localhost:3000 locally, your Vercel URL after deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000
